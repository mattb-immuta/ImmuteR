# consumption risk
consumption_risk, licensed_users,max_reg_users, days_until_renewal,
`Next Use Case Deployment Date`,`Expected User Count` ,
#engagement risk
engagement_risk,`Date of last EBR`, `Date of next EBR`)
for(i in fiscal.period){
