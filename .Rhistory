digits = 3 )
names(output)
datatable(output,
escape = which(names(output) %in% columns_to_not_escape_names), # THIS LINE IS CORRECT AND ESSENTIAL
# REMOVED the conflicting columnDefs for 'opportunity_link'
# If you have other columns you genuinely want to hide, add them here.
# For example, if you wanted to hide 'Opportunity_Name' and keep 'opportunity_link' visible:
options = list(
columnDefs = list(
list(visible = FALSE, targets = which(names(output) == "consumption_url") - 1),
list(visible = FALSE, targets = which(names(output) == "opportunity_url") - 1),
list(className = "wrap-text", width = '200px', targets = which(names(output) == "utilization_url") - 1)
)
),
class = 'cell-border stripe',
rownames = FALSE) %>%
formatCurrency(
columns = c('Amount'),
currency = '<span class="math-inline">',
mark = ',',
digits = 2
) %>%
formatRound(
columns = c('company_churn_hazard'),
digits = 3 )
DT::datatable(output)
DT::datatable(output,
options = list(
pageLength = 10,          # Display 3 rows per page
lengthMenu = c(3, 5, 10, 20), # Options for rows per page dropdown
searching = TRUE,        # Enable the search box
ordering = TRUE,         # Enable column sorting
paging = TRUE,           # Enable pagination
info = TRUE,             # Show "Showing X to Y of Z entries" info
dom = 'lfrtip'           # Standard layout: Length, Filter, Table, Info, Paging
),
caption = "Sales Transactions Data" # Add a table caption
)
