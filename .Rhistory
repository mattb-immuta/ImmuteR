)
output$plot
df=op_list$renewals %>%
filter(churn_forecast_period ==churn.period) %>%
mutate(account_name = paste0('<a href="', account_url, '" target="_blank">',`Account Name`, '</a>')) %>%
mutate(links = paste0('<a href="', consumption_url, '" target="_blank">',"utilization db", '</a> \n <a href="',
running_estimate_url,'" target="_blank">',"success plan", '</a>')) %>%
select(account_name,Region, Amount,`Churn Forecast`, `Close Date`,`Account Risk`,`Next Step`,consumption)
df=op_list$renewals %>%
filter(churn_forecast_period ==churn.period) %>%
mutate(account_name = paste0('<a href="', account_url, '" target="_blank">',`Account Name`, '</a>')) %>%
mutate(links = paste0('<a href="', consumption_url, '" target="_blank">',"utilization db", '</a> \n <a href="',
running_estimate_url,'" target="_blank">',"success plan", '</a>')) %>%
select(account_name,Region, Amount,`Churn Forecast`, `Close Date`,`Account Risk`,`Next Step`,links)
output=list()
output[["plot"]]<-reactable(df,filterable = TRUE, resizable = TRUE, bordered=TRUE, minRows = 10,
columns = list(
account_name = colDef(html=TRUE),
`Close Date`=colDef(format = colFormat(date = TRUE)),
`Churn Forecast` = colDef(format = colFormat(prefix = "$", separators = TRUE, digits = 0),
aggregate = "sum"),
Amount = colDef(format = colFormat(prefix = "$", separators = TRUE, digits = 0),
aggregate = "sum"),
`Next Step`=colDef(minWidth=250),
links = colDef(html=TRUE))
)
output$plot
library(googlesheets4)
library(data.table)
library(salesforcer)
library(dplyr)
library(stringr)
library(reactable)
library(htmltools)
library(roxygen2)
library(gt)
library(scales)
library(arrow)
library(tidyverse)
options(scipen = 999)
rm(list=ls())
#paths and identifiers for external data calls and writes
# google sheet read/write locations
account_doc_tracker<-"https://docs.google.com/spreadsheets/d/1Rxl25OyKEW1W1ny8Vbv3TDa2QCqR9VSpTN0QVPu6o9w/edit?usp=sharing"
looker_user_data_path<-"https://docs.google.com/spreadsheets/d/11GQF96cDxwpidj0_OgvliNZiShug5e4lVyIqGCM6Qj0/edit?usp=sharing"
customer_ops_tracker<-"https://docs.google.com/spreadsheets/d/1BS3rBeDZJBflauFZc5cEdw09JTAfBM5Hwbcdh1rk1Bg/edit?usp=sharing"
customer_expansion_tracker="https://docs.google.com/spreadsheets/d/1gI5N6FHArFMn65y1y_9pc1l9TUJGViHxYkzVXbHNk9Y/edit?gid=0#gid=0"
BU_staging="https://docs.google.com/spreadsheets/d/1WuHvaVkHrLQkoUB9MiDe7OvM4Qw6JyQW25KWaJbjJpA/edit?gid=493722263#gid=493722263"
mb_tracker<-"https://docs.google.com/spreadsheets/d/1BLwqFOZpEmDvBkIAH7rCYBzPIJ0ADIUJfndzDRe9WgM/edit?usp=sharing"
#authenticate
diff_date="2025-08-29"
fiscal.period=c("Q3-2026","Q4-2026","Q1-2027","Q2-2027")
sf_auth()
devtools::load_all("R/")
sf_opportunity_report <- "00OVH000005p6A92AI"
sf_account_report <- "00OVH0000069G8Y2AU"
sf_provision_report<-"00OVH000006Zryr2AC"
sf_support_case_report="00OVH000006dyX72AI"
sf_contract_report = "00OVH0000070ZRZ2A2"
idex=TRUE
re_tracker="https://docs.google.com/spreadsheets/d/1Rxl25OyKEW1W1ny8Vbv3TDa2QCqR9VSpTN0QVPu6o9w/edit?usp=sharing"
message(".. enrich_opportunities initiated /n")
c=load_constants()
c$fiscal.period=fiscal.period
# create necessary hyperlinks
opportunity.table<-sf_run_report(sf_opportunity_report)
account.table<- sf_run_report(sf_account_report)
marketplace.table<-sf_run_report(sf_provision_report)
support.case.table<-sf_run_report(sf_support_case_report)
contract.table<-sf_run_report(sf_contract_report) %>%
filter(`Order Status`=="Active")
opportunity.table$`Fiscal Period`<-factor(opportunity.table$`Fiscal Period`,levels=fiscal.period)
opportunity.table$opportunity_url=paste("https://immuta.lightning.force.com/lightning/r/Opportunity/",as.character(opportunity.table$`Opportunity ID`),"/view",sep="")
opportunity.table$account_url=paste("https://immuta.lightning.force.com/lightning/r/Account/",opportunity.table$`Account ID`,"/view",sep="")
opportunity.table$consumption_url=paste("https://immuta.cloud.looker.com/dashboards/1052?Name=",gsub(" ","+",opportunity.table$`Account Name`),"&Account+ID=&Report+Month=6+month&Instance+Name=&Instance+Type=Production",sep="")
# split into expansions and renewals
renewals<-opportunity.table[as.logical(opportunity.table$`Opportunity Record Type` =='Renewal'),]
expansions<-opportunity.table[as.logical(opportunity.table$`Opportunity Record Type` =='Expansion'),]
message("opportunity data collected...enrich account data")
consumption=enrich_consumption(idex=TRUE)
account.table<-enrich_account.table(account.table,renewals,consumption.list=consumption)
re.table=read_sheet(ss=re_tracker)
View(re.table)
account.table=merge(account.table,re.table[,c('Account Name','running_estimate_url')],all.x=TRUE)
account.table$running_estimate_hyperlink=paste("[Running Estimate](",account.table$running_estimate_url,")",sep="")
renewal.table=renewals
phat=c$phat_account
renewal.table=merge(renewal.table,
account.table[,c("Account ID",names(account.table)[as.logical(1-names(account.table) %in% names(renewal.table))])],
by="Account ID",all.x=TRUE)
risk.values=c('3. Low Risk','2. Moderate Risk','1. High Risk','Planned Lost','Closed Lost','0. Will Lose','0. Will Lose (Formally Notified)','4. Will Win',"Closed Won")
renewal.table =renewal.table[renewal.table$`Fiscal Period` %in% fiscal.period,]
renewal.table$Amount=as.numeric(extract_usd_amount(renewal.table$Amount),scientific=FALSE)
renewal.table$`Churn Forecast`=as.numeric(extract_usd_amount(renewal.table$`Churn Forecast`),scientific=FALSE)
temp_tier <- matrix(c('Tier III','Tier III','Tier II','Tier III','Tier II','Tier I','Tier II','Tier I','Tier I',
rep('plan lost',3),rep('Closed Lost',3),rep('0. Will Lose',3),rep('0. Will Lose (Formally Notified)',3),rep('4. Will Win',3),rep('Closed Won',3)),ncol=3,byrow=TRUE)
row.names(temp_tier)=risk.values
colnames(temp_tier)=c('small','medium','large')
d=length(renewal.table$Amount)
value_array=priority_array=phat_expected_array=array("No Risk Estimate",dim=d)
worst_array=expected_array=best_array=array(NA,dim=d)
p_sequence=1:d
p_sequence=p_sequence[-which(renewal.table$`Account Risk`=="-")]
small_indecies=which(renewal.table$Amount<150000)
med_indecies=which(renewal.table$Amount>=150000 & renewal.table$Amount<500000)
large_indecies=which(renewal.table$Amount>=500000)
value_array[small_indecies]='small'
value_array[med_indecies]='medium'
value_array[large_indecies]='large'
p_sequence
length(renewal.table$Amount)
renewal.table$`Account Risk`
d=length(renewal.table$Amount)
value_array=priority_array=phat_expected_array=array("No Risk Estimate",dim=d)
worst_array=expected_array=best_array=array(NA,dim=d)
p_sequence=1:d
p_sequence=p_sequence[-which(renewal.table$`Account Risk`=="-")]
renewal.table$`Account Risk`
p_sequence
p_sequence=1:d
renewal.table$`Account Risk`=="-"
-which(renewal.table$`Account Risk`=="-")
-which(renewal.table$`Account Risk`=="-")==0
tmp=which(renewal.table$`Account Risk`=="-")
tmp==0
!tmp==0
!(tmp==0)
tmp
tmp=sum(renewal.table$`Account Risk`=="-")
tmp
!(tmp==0)
#renewal.table=renewals
renewal.table=merge(renewal.table,
account.table[,c("Account ID",names(account.table)[as.logical(1-names(account.table) %in% names(renewal.table))])],
by="Account ID",all.x=TRUE)
renewal.table=renewals
#renewal.table=renewals
renewal.table=merge(renewal.table,
account.table[,c("Account ID",names(account.table)[as.logical(1-names(account.table) %in% names(renewal.table))])],
by="Account ID",all.x=TRUE)
risk.values=c('3. Low Risk','2. Moderate Risk','1. High Risk','Planned Lost','Closed Lost','0. Will Lose','0. Will Lose (Formally Notified)','4. Will Win',"Closed Won")
renewal.table =renewal.table[renewal.table$`Fiscal Period` %in% fiscal.period,]
renewal.table$Amount=as.numeric(extract_usd_amount(renewal.table$Amount),scientific=FALSE)
renewal.table$`Churn Forecast`=as.numeric(extract_usd_amount(renewal.table$`Churn Forecast`),scientific=FALSE)
temp_tier <- matrix(c('Tier III','Tier III','Tier II','Tier III','Tier II','Tier I','Tier II','Tier I','Tier I',
rep('plan lost',3),rep('Closed Lost',3),rep('0. Will Lose',3),rep('0. Will Lose (Formally Notified)',3),rep('4. Will Win',3),rep('Closed Won',3)),ncol=3,byrow=TRUE)
row.names(temp_tier)=risk.values
colnames(temp_tier)=c('small','medium','large')
d=length(renewal.table$Amount)
value_array=priority_array=phat_expected_array=array("No Risk Estimate",dim=d)
worst_array=expected_array=best_array=array(NA,dim=d)
p_sequence=1:d
tmp=sum(renewal.table$`Account Risk`=="-")
if(!(tmp==0)) p_sequence=p_sequence[-which(renewal.table$`Account Risk`=="-")]
small_indecies=which(renewal.table$Amount<150000)
med_indecies=which(renewal.table$Amount>=150000 & renewal.table$Amount<500000)
large_indecies=which(renewal.table$Amount>=500000)
value_array[small_indecies]='small'
value_array[med_indecies]='medium'
value_array[large_indecies]='large'
for(i in p_sequence){
priority_array[i]<-temp_tier[which(rownames(temp_tier)==renewal.table$`Account Risk`[i]),which(colnames(temp_tier)==value_array[i])]
phat_expected_array[i]<-1-phat$expected[which(phat$risk.vec==renewal.table$`Account Risk`[i])]
worst_array[i]<-(1-phat$worst_case[which(phat$risk.vec==renewal.table$`Account Risk`[i])])*as.numeric(renewal.table$Amount[i])
expected_array[i]<-(1-phat$expected[which(phat$risk.vec==renewal.table$`Account Risk`[i])])*as.numeric(renewal.table$Amount[i])
best_array[i]<-(1-phat$best_case[which(phat$risk.vec==renewal.table$`Account Risk`[i])])*as.numeric(renewal.table$Amount[i])
}
renewal.table$priority_change=renewal.table$Priority!=priority_array #bug
renewal.table$Priority<-priority_array
renewal.table$phat_expected=phat_expected_array
renewal.table$best_case_churn=best_array
renewal.table$expected_churn=expected_array
renewal.table$worst_case_churn=worst_array
renewal.table$days_until_renewal=as.numeric(as.Date(renewal.table$`Close Date`)-rep(Sys.Date(),dim(renewal.table)[1]))
renewal.table$consumption_risk=rep("moderate",length(renewal.table$max_consumption))
renewal.table$max_consumption_risk[renewal.table$days_until_renewal<120 & renewal.table$max_consumption<.6]="high"
renewal.table$max_consumption_risk[renewal.table$max_consumption>.9]="low"
renewal.table$`Churn Forecast`[is.na(renewal.table$`Churn Forecast`)]=0
renewal.table$expected_churn[is.na(renewal.table$expected_churn)]=0
renewal.table$company_churn_hazard=renewal.table$expected_churn/sum(renewal.table$expected_churn)
#generate the churn forecast period by adding 1 day to the contract end date
renewal.table$rev_lost_day=as.Date(renewal.table$`Current Contract End Date`)+1
renewal.table$churn_forecast_period=date_to_fiscal_quarter(renewal.table$rev_lost_day)
message(".. renewal data enriched /n")
renewal.table$company_churn_hazard
