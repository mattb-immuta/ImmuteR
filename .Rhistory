sum(op_list$accounts$Databricks)
for (file in op_list$accounts$`Account Name`) {
# Construct the full file path including the folder and .md extension
file_path <- file.path("data/account_notes", paste0(file, ".md"))
# Check if the file already exists to avoid overwriting
if (!file.exists(file_path)) {
# Create an empty file
file.create(file_path)
cat(paste0("Created blank Markdown file: '", file_path, "'\n"))
} else {
cat(paste0("Markdown file already exists, skipping: '", file_path, "'\n"))
}
}
}
