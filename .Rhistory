#authenticate
diff_date="2025-07-10"
fiscal.period=c("Q2-2026","Q3-2026","Q4-2026","Q1-2027")
sf_auth()
devtools::load_all("R/")
#load and enrich data
new_op_list=enrich_opportunities(#input paths
sf_opportunity_report <- "00OVH000005p6A92AI",
sf_account_report <- "00OVH0000069G8Y2AU",
sf_provision_report<-"00OVH000006Zryr2AC",
sf_support_case_report="00OVH000006dyX72AI",
idex=TRUE)
load(paste("data/opportunities_",diff_date,".RData",sep=""))
#op_list=output_list # hacky until compared object is of same structure
op_list=enrich_list_object(new_list=new_op_list,
old_list=op_list)
rm(list=ls())
load("~/Documents/projects/ImmuteR/data/opportunities_2025-07-10.RData")
naps(op_list)
names(op_list)
names(op_list$renewals)
names(op_list$renewals)[13]
names(op_list$renewals)[13]="Account Risk"
names(op_list)
names(op_list$expansions)
names(op_list$renewals)[33]="Account Risk"
names(op_list$accounts)
names(op_list$accounts)[16]="Account Risk"
names(op_list$marketplace)
names(op_list$renewal_changes)
names(op_list$renewal_changes)[c(3,4)]
names(op_list$renewal_changes)[c(3,4)]=rep("Account Risk",2)
names(op_list)
names(op_list$customer_ops_tracker)
names(op_list$customer_ops_tracker)[7]="Account Risk"
save(op_list,file="data/opportunities_2025-07-10.RData")
