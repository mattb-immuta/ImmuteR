# Pull the same raw data the function uses
raw <- load_op_list_raw()  # or point to your cache
users <- raw$users
# Recreate users_agg exactly as the function does
.sum_or_na <- function(x) {
v <- suppressWarnings(as.numeric(gsub(",", "", as.character(x))))
if (all(is.na(v))) NA_real_ else sum(v, na.rm = TRUE)
}
.first_or_na <- function(x) {
v <- x[!is.na(x)]
if (length(v) == 0) NA else v[[1]]
}
users_agg <- users |>
dplyr::filter(`Immuta Instances Instance Type` == "Production") |>
dplyr::group_by(`Salesforce Accounts Account Name`) |>
dplyr::summarise(
`Registered Users`    = .sum_or_na(`[Usage Metrics] Users in System`),
`Licensed Users`      = .first_or_na(`Salesforce Contracts All Contracted Users`),
`Prod Instance Count` = dplyr::n(),
.groups = "drop"
) |>
dplyr::rename(`Account Name` = `Salesforce Accounts Account Name`)
users_agg |> dplyr::filter(grepl("AstraZeneca", `Account Name`, ignore.case = TRUE))
op_list$consumption$low_consumption |>
dplyr::filter(`Account Name` == "AstraZeneca") |>
dplyr::select(`Account Name`, `Registered Users`, `Licensed Users`)
# Check if users_prod has a Registered Users column
"Registered Users" %in% names(users_prod)
.shared_join_cols <- c("Immuta Instances Instance Type",
"Immuta Instances Deployment Platform")
users_prod <- users |>
dplyr::filter(`Immuta Instances Instance Type` == "Production") |>
dplyr::mutate(.uis = suppressWarnings(as.numeric(`[Usage Metrics] Users in System`))) |>
dplyr::group_by(`Salesforce Accounts Account Name`) |>
dplyr::slice_max(order_by = .uis, n = 1, with_ties = FALSE) |>
dplyr::ungroup() |>
dplyr::rename(`Account Name` = `Salesforce Accounts Account Name`) |>
dplyr::select(-dplyr::any_of(.shared_join_cols), -.uis)
# Now check
"Registered Users" %in% names(users_prod)
step1 <- account_base |> dplyr::left_join(users_agg, by = "Account Name")
account_base <- op_list$accounts |>
dplyr::select(
`Account ID`, `Account Name`, `Contract ARR Rollup`,
`Is SaaS Customer`, `Customer on Unsupported Version`, `Lifecycle Stage`
)
# Now run the checks
"Registered Users" %in% names(users_prod)
step1 <- account_base |> dplyr::left_join(users_agg, by = "Account Name")
step2 <- step1 |> dplyr::left_join(users_prod, by = "Account Name")
step1 |> dplyr::filter(`Account Name` == "AstraZeneca") |> dplyr::select(`Account Name`, `Registered Users`)
step2 |> dplyr::filter(`Account Name` == "AstraZeneca") |> dplyr::select(`Account Name`, `Registered Users`)
devtools::load_all()
source("scripts/serve.R")
