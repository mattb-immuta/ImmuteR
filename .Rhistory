new_op_list=enrich_opportunities(#input paths
sf_opportunity_report <- "00OVH000005p6A92AI",
sf_account_report <- "00OVH0000069G8Y2AU",
sf_provision_report<-"00OVH000006Zryr2AC",
sf_support_case_report="00OVH000006dyX72AI",
idex=TRUE)
rm(list=ls())
#paths and identifiers for external data calls and writes
# google sheet read/write locations
account_doc_tracker<-"https://docs.google.com/spreadsheets/d/1Rxl25OyKEW1W1ny8Vbv3TDa2QCqR9VSpTN0QVPu6o9w/edit?usp=sharing"
looker_user_data_path<-"https://docs.google.com/spreadsheets/d/11GQF96cDxwpidj0_OgvliNZiShug5e4lVyIqGCM6Qj0/edit?usp=sharing"
customer_ops_tracker<-"https://docs.google.com/spreadsheets/d/1BS3rBeDZJBflauFZc5cEdw09JTAfBM5Hwbcdh1rk1Bg/edit?usp=sharing"
customer_expansion_tracker="https://docs.google.com/spreadsheets/d/1gI5N6FHArFMn65y1y_9pc1l9TUJGViHxYkzVXbHNk9Y/edit?gid=0#gid=0"
mb_tracker<-"https://docs.google.com/spreadsheets/d/1BLwqFOZpEmDvBkIAH7rCYBzPIJ0ADIUJfndzDRe9WgM/edit?usp=sharing"
#authenticate
diff_date="2025-07-10"
fiscal.period=c("Q2-2026","Q3-2026","Q4-2026","Q1-2027")
sf_auth()
sf_opportunity_report <- "00OVH000005p6A92AI"
sf_account_report <- "00OVH0000069G8Y2AU"
sf_provision_report<-"00OVH000006Zryr2AC"
sf_support_case_report="00OVH000006dyX72AI"
idex=TRUE
c=load_constants()
# create necessary hyperlinks
opportunity.table<-sf_run_report(sf_opportunity_report)
account.table<- sf_run_report(sf_account_report)
marketplace.table<-sf_run_report(sf_provision_report)
support.case.table<-sf_run_report(sf_support_case_report)
opportunity.table$opportunity_url=paste("https://immuta.lightning.force.com/lightning/r/Opportunity/",as.character(opportunity.table$`Opportunity ID`),"/view",sep="")
opportunity.table$account_url=paste("https://immuta.lightning.force.com/lightning/r/Account/",opportunity.table$`Account ID`,"/view",sep="")
opportunity.table$consumption_url=paste("https://immuta.cloud.looker.com/dashboards/1052?Name=",gsub(" ","+",opportunity.table$`Account Name`),"&Account+ID=&Report+Month=6+month&Instance+Name=&Instance+Type=Production",sep="")
# split into expansions and renewals
renewals<-opportunity.table[as.logical(opportunity.table$`Opportunity Record Type` =='Renewal'),]
expansions<-opportunity.table[as.logical(opportunity.table$`Opportunity Record Type` =='Expansion'),]
message("opportunity data collected...enrich account data")
account.table<-enrich_account.table(account.table,renewals,idex)
re.table=read_sheet(ss=re_tracker)
account.table=merge(account.table,re.table[,c('Account Name','running_estimate_url')],all.x=TRUE)
re_tracker="https://docs.google.com/spreadsheets/d/1Rxl25OyKEW1W1ny8Vbv3TDa2QCqR9VSpTN0QVPu6o9w/edit?usp=sharing"
re.table=read_sheet(ss=re_tracker)
account.table=merge(account.table,re.table[,c('Account Name','running_estimate_url')],all.x=TRUE)
account.table$running_estimate_hyperlink=paste("[Running Estimate](",account.table$running_estimate_url,")",sep="")
renewal.table=renewals
account.table=account.table
phat=c$phat_adoption
fiscal.period=c("Q2-2026","Q3-2026","Q4-2026","Q1-2027")
renewal.table=merge(renewal.table,
account.table[,c("Account ID",names(account.table)[as.logical(1-names(account.table) %in% names(renewal.table))])],
by="Account ID",all.x=TRUE)
risk.values=c('3. Low Risk','2. Moderate Risk','1. High Risk','Planned Lost','Closed Lost','0. Will Lose','0. Will Lose (Formally Notified)','Planned Won',"Closed Won")
renewal.table =renewal.table[renewal.table$`Fiscal Period` %in% fiscal.period,]
renewal.table$Amount=as.numeric(extract_usd_amount(renewal.table$Amount),scientific=FALSE)
renewal.table$`Churn Forecast`=as.numeric(extract_usd_amount(renewal.table$`Churn Forecast`),scientific=FALSE)
temp_tier <- matrix(c('Tier III','Tier III','Tier II','Tier III','Tier II','Tier I','Tier II','Tier I','Tier I',
rep('plan lost',3),rep('closed lost',3),rep('0. Will Lose',3),rep('plan won',3),rep('closed won',3)),ncol=3,byrow=TRUE)
temp_tier
temp_tier <- matrix(c('Tier III','Tier III','Tier II','Tier III','Tier II','Tier I','Tier II','Tier I','Tier I',
rep('plan lost',3),rep('closed lost',3),rep('0. Will Lose',3),rep('0. Will Lose (Formally Notified)',3),rep('plan won',3),rep('closed won',3)),ncol=3,byrow=TRUE)
temp_tier
row.names(temp_tier)=risk.values
temp_tier
colnames(temp_tier)=c('small','medium','large')
d=length(renewal.table$Amount)
value_array=priority_array=array("No Risk Estimate",dim=d)
worst_array=expected_array=best_array=array(NA,dim=d)
p_sequence=1:d
p_sequence=p_sequence[-which(renewal.table$`Account Risk`=="-")]
small_indecies=which(renewal.table$Amount<150000)
med_indecies=which(renewal.table$Amount>=150000 & renewal.table$Amount<500000)
large_indecies=which(renewal.table$Amount>=500000)
value_array[small_indecies]='small'
value_array[med_indecies]='medium'
value_array[large_indecies]='large'
for(i in p_sequence){
priority_array[i]<-temp_tier[which(rownames(temp_tier)==renewal.table$`Account Risk`[i]),which(colnames(temp_tier)==value_array[i])]
worst_array[i]<-(1-phat$worst_case[which(phat$risk.vec==renewal.table$`Account Risk`[i])])*as.numeric(renewal.table$Amount[i])
expected_array[i]<-(1-phat$expected[which(phat$risk.vec==renewal.table$`Account Risk`[i])])*renewal.table$Amount[i]
best_array[i]<-(1-phat$best_case[which(phat$risk.vec==renewal.table$`Account Risk`[i])])*renewal.table$Amount[i]
}
