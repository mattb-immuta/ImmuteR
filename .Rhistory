sf_support_case_report="00OVH000006dyX72AI",
sf_contract_report = "00OVH0000070ZRZ2A2",
fiscal.period<-fiscal.period,
idex=FALSE)
load(paste("data/opportunities_",diff_date,".RData",sep=""))
