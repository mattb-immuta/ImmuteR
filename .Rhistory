sf_contract_report = "00OVH0000070ZRZ2A2",
fiscal.period<-fiscal.period,
idex=FALSE)
library(googlesheets4)
library(data.table)
library(salesforcer)
library(dplyr)
library(stringr)
library(reactable)
library(htmltools)
library(roxygen2)
library(gt)
library(scales)
library(arrow)
library(tidyverse)
options(scipen = 999)
rm(list=ls())
#paths and identifiers for external data calls and writes
# google sheet read/write locations
account_doc_tracker<-"https://docs.google.com/spreadsheets/d/1Rxl25OyKEW1W1ny8Vbv3TDa2QCqR9VSpTN0QVPu6o9w/edit?usp=sharing"
looker_user_data_path<-"https://docs.google.com/spreadsheets/d/11GQF96cDxwpidj0_OgvliNZiShug5e4lVyIqGCM6Qj0/edit?usp=sharing"
customer_ops_tracker<-"https://docs.google.com/spreadsheets/d/1BS3rBeDZJBflauFZc5cEdw09JTAfBM5Hwbcdh1rk1Bg/edit?usp=sharing"
customer_expansion_tracker="https://docs.google.com/spreadsheets/d/1gI5N6FHArFMn65y1y_9pc1l9TUJGViHxYkzVXbHNk9Y/edit?gid=0#gid=0"
BU_staging="https://docs.google.com/spreadsheets/d/1WuHvaVkHrLQkoUB9MiDe7OvM4Qw6JyQW25KWaJbjJpA/edit?gid=493722263#gid=493722263"
mb_tracker<-"https://docs.google.com/spreadsheets/d/1BLwqFOZpEmDvBkIAH7rCYBzPIJ0ADIUJfndzDRe9WgM/edit?usp=sharing"
#authenticate
diff_date="2026-01-12"
fiscal.period=c("Q1-2027","Q2-2027","Q3-2027","Q4-2027")
sf_auth()
devtools::load_all("R/")
#load and enrich data
new_op_list=enrich_opportunities(#input paths
sf_opportunity_report <- "00OVH000005p6A92AI",
sf_account_report <- "00OVH0000069G8Y2AU",
sf_provision_report<-"00OVH000006Zryr2AC",
sf_support_case_report="00OVH000006dyX72AI",
sf_contract_report = "00OVH0000070ZRZ2A2",
fiscal.period<-fiscal.period,
idex=FALSE)
load(paste("data/opportunities_",diff_date,".RData",sep=""))
op_list=enrich_list_object(new_list=new_op_list,
old_list=op_list)
op_list[["constants"]]=load_constants()
# produce outputs
# push updates to my spreadsheet
#output_gsheet_mbpipeline(op_list=op_list,mb_tracker)
output_customer_ops_tracker(op_list=op_list,customer_ops_tracker,fiscal.period=c("Q1-2027","Q2-2027","Q3-2027","Q4-2027"))
output_gsheet_BU_staging(op_list=op_list,BU_staging,fiscal.period=c("Q1-2027","Q2-2027","Q3-2027","Q4-2027"))
#Notes:  Need to update generate_forecast() to output mutliple quarters with colnames per quarter
library(plotly)
f=generate_forecast(op_list,
churn.quarters=c("Q4-2026","Q1-2027","Q2-2027","Q3-2027","Q4-2027"),
p=c(.6,.2))
company_plan=c(2134005,778948,902220,81000,1133956)
p=c( sum(company_plan[1]>=f$`Q4-2026`),
sum(company_plan[2]>=f$`Q1-2027`),
sum(company_plan[3]>=f$`Q2-2027`),
sum(company_plan[4]>=f$`Q3-2027`))/1000
fig <- plot_ly(y =f$`Q4-2026`, type = "box", quartilemethod="exclusive",name="FY26Q4",
showlegend = FALSE) %>%
add_trace(y=f$`Q1-2027`,name="FY27Q1") %>%
add_trace(y=f$`Q2-2027`,name="FY27Q2") %>%
add_trace(y=f$`Q3-2027`,name="FY27Q3") %>%
add_trace(y=f$`Q4-2027`,name="FY27Q4") %>%
add_trace(
x = "FY26Q4",
y = company_plan[1],
type = "scatter",
mode = "markers+text",
text= p[1],
textposition= "right",
marker = list(
size = 12,
color = "black",
symbol = "diamond"),
name = "Company Plan") %>%
add_trace(
x = "FY27Q1",
y = company_plan[2],
type = "scatter",
mode = "markers+text",
text= p[2],
textposition= "right",
marker = list(
size = 12,
color = "black",
symbol = "diamond"),
name = "Company Plan",
showlegend = FALSE) %>%
add_trace(
x = "FY27Q2",
y = company_plan[3],
type = "scatter",
mode = "markers+text",
text= p[3],
textposition= "right",
marker = list(
size = 12,
color = "black",
symbol = "diamond"),
name = "Company Plan",
showlegend = FALSE) %>%
add_trace(
x = "FY27Q3",
y = company_plan[4],
type = "scatter",
mode = "markers+text",
text= p[4],
textposition= "right",
marker = list(
size = 12,
color = "black",
symbol = "diamond"),
name = "Company Plan",
showlegend = FALSE) %>%
add_trace(
x = "FY27Q4",
y = company_plan[5],
type = "scatter",
mode = "markers+text",
text= p[5],
textposition= "right",
marker = list(
size = 12,
color = "black",
symbol = "diamond"),
name = "Company Plan",
showlegend = FALSE) %>%
layout(title = paste0("FY26Q4-FY27Q4 Forecast as of ",Sys.Date()),
yaxis=list(tickformat="$,.2s"))
fig
