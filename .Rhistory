library(kableExtra)
my_record <- data.frame(
ID = "ABC-123",
ProductName = "Super Widget Pro",
Price = 129.99,
Quantity = 5,
OrderDate = as.Date("2025-07-09"),
Status = "Completed"
)
my_record %>%
t() %>% # Transpose for better display of a single row
as.data.frame() %>%
rownames_to_column(var = "Field") %>%
setNames(c("Field", "Value")) %>%
kable("html") %>%
kable_styling(bootstrap_options = c("striped", "hover"),
full_width = FALSE) %>%
row_spec(0, bold = TRUE, background = "#D6EAF8") %>%
column_spec(1, bold = TRUE)
