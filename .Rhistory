engagement_risk,`Date of last EBR`, `Date of next EBR`)
for(i in fiscal.period){
temp=output %>%
filter(`Fiscal Period`==i) %>%
select(-`Fiscal Period`)
sheet_write(temp,ss=customer_expansion_tracker,sheet=i)
}
}
